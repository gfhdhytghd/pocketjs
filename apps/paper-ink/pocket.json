{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.paper-ink",
  "name": "pocketjs-paper-ink",
  "title": "PocketJS: Paper Ink",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "input.touch",
        "text.glyphs.baked"
      ]
    }
  },
  "app": {
    "entry": "apps/paper-ink/main.tsx",
    "output": "paper-ink-main",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [
          309,
          412
        ],
        "presentation": "native"
      }
    }
  }
}
