{
  // The daemon carries native dependencies (node-pty) the repository gate
  // must not require, so the root tsconfig excludes this directory and this
  // one takes over for editors + `bunx tsc --noEmit` run here after a local
  // `bun install`. grid.ts/keys.ts/wire.ts stay dependency-free and are
  // typechecked at the root through the tests that import them.
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "."
  },
  "include": ["."]
}
